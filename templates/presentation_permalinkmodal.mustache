{{!
 @template local_apsolu/presentation_permalinkmodal

    Template Moodle pour afficher une modal contenant un lien permanent exportable.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * link - string - l'URL complète du lien permanent

    Example context (json):
    {
        "string": ""
    }
}}
<div class="apsolu-permalink">
    <div class="input-group">
        <input id='apsolu-offerings-permalink-input' 
            type="text"
            class="form-control-sm apsolu-permalink-link bg-light px-2"
            value="{{link}}"
            readonly
            onclick="this.select();">
        <div class="input-group-append">
            <button type="button"
                    class="btn btn-outline-secondary apsolu-permalink-copy"
                    data-value="{{link}}"
                    title="{{#str}} copy, local_apsolu {{/str}}"
                    aria-label="{{#str}} copy, local_apsolu {{/str}}">
                <i class="fa fa-copy" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <p class="apsolu-offerings-permalink-help mt-2 text-muted small">
        {{#str}} permalink_help, local_apsolu{{/str}}
    </p>
</div>