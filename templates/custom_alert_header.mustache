{{!
    @template local_apsolu/custom_alert_header

    Template Moodle pour afficher un bandeau d'information avec un message personnalisé.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * headerclass classe de la div contenant le message
    * headercontent contenu du message (html)
    * headerdismiss témoin de la présence d'un bouton 'fermer'

    Example context (json):
    {
        "headerclass": "",
        "headercontent": "",
        "headerdismiss": false
    }
}}
<div class="{{headerclass}}" role="alert" data-aria-autofocus="true">
    {{{headercontent}}}
    {{#headerdismiss}}
    <button type="button" class="btn-close" data-bs-dismiss="alert">
        <span class="visually-hidden">{{#str}}closebuttontitle{{/str}}</span>
    </button>
    {{/headerdismiss}}
</div>